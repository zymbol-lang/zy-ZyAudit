// EN: 召模.zy — model client for ZyAudit. Prefix: 模
// ES: 召模.zy — cliente de modelo para ZyAudit. Prefijo: 模
// ZH: 召模.zy — ZyAudit 的模型客户端。导出前缀：模
//
// Migrated to the v0.0.7 standard library through the Mandarin i18n adapters in
// 标准库/ (网络→std/net, 编解→std/json, 文件→std/io): the old curl/jq/temp-file
// plumbing is gone, and no English std names leak into the code. Supports two
// providers, selectable at
// runtime: "ollama" (local, /api/generate) and "gemini" (Google web API, auth
// header). The only remaining BashExec call is `command -v ollama` (a CLI check).

# .字审_召模 {
    <# ./标准库/网络 => 网络
    <# ./标准库/编解 => 编解
    <# ./标准库/文件 => 文件

    主机   = "http://localhost:11434"
    临目   = "/tmp/ZyAudit"
    提供者 = "ollama"
    密钥   = ""

    #> {
        模_主机
        模_临目
        模_设主机
        模_提供者
        模_设提供者
        模_设密钥
        模_已装
        模_检查
        模_存在
        模_列表
        模_发送
    }

    模_主机() { <~ 主机 }
    模_临目() { <~ 临目 }
    模_提供者() { <~ 提供者 }
    模_设提供者(值) { 提供者 = 值 }
    模_设密钥(值) { 密钥 = 值 }

    // EN/ES/ZH: Update host in place. Accepts "ip", "ip:port", or "http://...".
    模_设主机(地址) {
        协议位 = 地址$?? "://"
        新主机 = ""
        ? (协议位$# == 0) {
            冒位 = 地址$?? ":"
            ? (冒位$# == 0) {
                新主机 = "http://" $+ 地址 $+ ":11434"
            } _ {
                新主机 = "http://" $+ 地址
            }
        } _ {
            新主机 = 地址
        }
        主机 = 新主机
    }

    // EN: #1 if the `ollama` binary is in PATH (CLI check — not a gap).
    模_已装() {
        结果 = <\ "command -v ollama > /dev/null 2>&1 && echo 1 || echo 0" \>
        <~ (结果$~~["\n":""] == "1")
    }

    // EN: Provider reachable? Gemini is "ready" if a key is set; Ollama: GET / → 200.
    模_检查() {
        ? (提供者 == "gemini") { <~ (密钥 <> "") }
        根 = 主机 "/"
        响 = 网络::获取(根)
        <~ (响$! == #0)
    }

    // EN: Model available? Gemini skips validation; Ollama scans /api/tags.
    模_存在(模型) {
        ? (提供者 == "gemini") { <~ #1 }
        网址 = 主机 "/api/tags"
        响 = 网络::获取(网址)
        ? 响$! { <~ #0 }
        <~ ((响$?? 模型)$# > 0)
    }

    // EN: Comma-separated list of installed Ollama models.
    模_列表() {
        网址 = 主机 "/api/tags"
        响 = 网络::获取(网址)
        ? 响$! { <~ "" }
        数据 = 编解::解码(响)
        出 = ""
        @ 项:数据.型列 {
            ? (出 == "") {
                出 = 项.名称
            } _ {
                出 = 出 ", " 项.名称
            }
        }
        <~ 出
    }

    // EN: Send a prompt and return the response text (routes to the active provider).
    模_发送(提示, 模型) {
        ? (提供者 == "gemini") {
            <~ 云_发送(提示, 模型)
        }
        <~ 本_发送(提示, 模型)
    }

    // EN: Ollama /api/generate (private).
    本_发送(提示, 模型) {
        网址 = 主机 "/api/generate"
        请求 = #(model: 模型, prompt: 提示, stream: #0)
        响 = 网络::发送数据(网址, 编解::编码(请求))
        ? 响$! { <~ "" }
        有 = (响$?? "response")$# > 0
        ? 有 {
            数据 = 编解::解码(响)
            <~ 数据.答复
        }
        <~ ""
    }

    // EN: Gemini generateContent with the X-goog-api-key header (private).
    //     The free tier caps requests-per-minute; on a rate-limit error we wait for the
    //     window to reset and retry (up to 3 times) instead of dropping the document.
    云_发送(提示, 模型) {
        基   = "https://generativelanguage.googleapis.com/v1beta/models/"
        网址 = 基 模型 ":generateContent"
        头   = [ ("X-goog-api-key", 密钥) ]
        体   = 编解::编码(#(contents: [ #(parts: [ #(text: 提示) ]) ]))
        响 = 网络::发送数据(网址, 体, 头)
        // One short retry recovers from a transient per-minute rate-limit without
        // hanging on the daily cap (free tier: only 20 requests/day per model).
        ? 响$! {
            _休 = <\ "sleep 15" \>
            响  = 网络::发送数据(网址, 体, 头)
        }
        ? 响$! { <~ "" }
        数据 = 编解::解码(响)
        <~ 数据.候选[1].内容.片段[1].文本
    }
}
